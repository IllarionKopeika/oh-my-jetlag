<div class="flight-card d-flex flex-column mb-2">

  <% modal_id = "flightMapModal-#{flight.id}" %>

  <div class="card-top">
    <div class="airline-info">
      <img class="airline-logo" src="<%= flight.airline.logo_url %>" alt="<%= flight.airline.name %>">
      <p class="m-0 flight-number"><%= flight.number %></p>
    </div>

    <div class="card-top-center">
      <i type="button"
         data-bs-toggle="modal"
         data-bs-target="#<%= modal_id %>"
         class="info-icon fa-solid fa-circle-info">
      </i>
      <div class="modal fade" id="<%= modal_id %>"
           tabindex="-1"
           aria-labelledby="<%= modal_id %>Label"
           aria-hidden="true">
        <%= render "modal", flight: flight, modal_id: modal_id %>
      </div>
    </div>

    <p class="m-0 flight-date"><%= format_date(flight.departure_local) %></p>
  </div>

  <div class="route-row">
    <div class="airport">
      <h4 class="my-0"><strong><%= flight.departure_airport.code %></strong></h4>
      <p class="my-0"><%= format_time(flight.departure_local) %></p>
    </div>

    <div class="middle-col">
      <span class="flight-duration"><%= format_duration(flight.duration) %></span>
      <div class="plane-line">
        <div class="route-line"></div>
        <i class="aircraft-icon fa-solid fa-plane"></i>
        <div class="route-line"></div>
      </div>
      <span class="aircraft-name"><%= flight.aircraft.name %></span>
    </div>

    <div class="airport">
      <h4 class="my-0"><strong><%= flight.arrival_airport.code %></strong></h4>
      <p class="my-0"><%= format_time(flight.arrival_local) %></p>
    </div>
  </div>

</div>
